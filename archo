#!/usr/bin/env sh
# Builds the CLI and the harness mod when their sources changed since the last build (or with ARCHO_REBUILD=1), then runs archo.
set -e
root="$(cd "$(dirname "$0")" && pwd)"
exe="$root/.bin/cli/archo.exe"
mod="$root/mod/1.7/Assemblies/ArchotechHarness.dll"

# Succeeds when the stamp is missing or any file under the paths, outside bin/ and obj/, is newer.
stale() {
  stamp="$1"
  shift
  [ ! -f "$stamp" ] || [ -n "$(find "$@" \( -name bin -o -name obj \) -prune -o -type f -newer "$stamp" -print -quit)" ]
}

# Builds a project, then records the time the build started in its stamp.
build() {
  stamp="$1"
  shift
  mkdir -p "$root/.bin"
  touch "$stamp.new"
  dotnet build "$@" -c Release --nologo -v q >&2
  mv "$stamp.new" "$stamp"
}

if [ -n "$ARCHO_REBUILD" ] || [ ! -f "$mod" ] \
  || stale "$root/.bin/mod.stamp" "$root/Source/ArchotechHarness" "$root/Source/Shared" "$root/build/FindRimWorld.props" "$root/Directory.Build.props"; then
  build "$root/.bin/mod.stamp" "$root/Source/ArchotechHarness/ArchotechHarness.csproj"
fi
if [ -n "$ARCHO_REBUILD" ] || [ ! -f "$exe" ] \
  || stale "$root/.bin/cli.stamp" "$root/Source/ArchotechHarness.Cli" "$root/Source/Shared" "$root/Directory.Build.props"; then
  build "$root/.bin/cli.stamp" "$root/Source/ArchotechHarness.Cli/ArchotechHarness.Cli.csproj" -o "$root/.bin/cli"
fi
exec "$exe" "$@"
