<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\FindRimWorld.props" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArchotechHarness</AssemblyName>
    <RootNamespace>ArchotechHarness</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\mod\1.7\Assemblies</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>$(RimWorldDir)\Brutal.ImGui.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Brutal.Core.Common">
      <HintPath>$(RimWorldDir)\Brutal.Core.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Brutal.Core.Strings">
      <HintPath>$(RimWorldDir)\Brutal.Core.Strings.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(RimWorldDir)\Brutal.Core.Numerics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)\Waylith.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArchotechHarness.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
