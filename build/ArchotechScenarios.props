<Project>
  <!-- Import from a scenarios .csproj, in this repo or a mod repo. -->
  <Import Project="$(MSBuildThisFileDirectory)FindRimWorld.props" />

  <PropertyGroup>
    <ArchoHome>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</ArchoHome>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS1998</NoWarn>
    <AssemblyName Condition="'$(ARCHO_SCENARIO_ASSEMBLY)' != ''">$(ARCHO_SCENARIO_ASSEMBLY)</AssemblyName>
    <OutDir Condition="'$(ARCHO_SCENARIO_OUTDIR)' != ''">$(ARCHO_SCENARIO_OUTDIR)\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)\UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(RimWorldDir)\Waylith.dll" Private="false" />
    <Reference Include="ArchotechHarness" HintPath="$(ArchoHome)\mod\1.7\Assemblies\ArchotechHarness.dll" Private="false" />
    <Reference Include="$(RimWorldDir)\Mods\*\1.7\Assemblies\0Harmony.dll" Private="false" />
    <Reference Include="$(RimWorldDir)\..\..\workshop\content\294100\*\1.7\Assemblies\0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Verse" />
    <Using Include="Verse.AI" />
    <Using Include="RimWorld" />
    <Using Include="ArchotechHarness.Scripting" />
    <Using Include="ArchotechHarness.Scripting.Script" Static="true" />
  </ItemGroup>
</Project>
